# App server
PORT=3000

# Public base URL used for TonConnect manifest and public links
PUBLIC_BASE_URL=https://durak.clown-on-stonks.fun
PUBLIC_APP_URL=https://durak.clown-on-stonks.fun/
TERMS_URL=https://durak.clown-on-stonks.fun/terms
PRIVACY_URL=https://durak.clown-on-stonks.fun/privacy

# Telegram Bot API token (required for Stars invoices and bot commands)
BOT_TOKEN=

# TON deposit settings
TON_RECEIVER=
TONCENTER_API_KEY=

# Admin controls
ADMIN_SECRET=
ADMIN_IDS=123456789,987654321

# Reverse proxy API prefix(es). Supports comma-separated values.
# Examples: /api or /api,/miniapp/api
API_PREFIX=/api

# Admin command format:
# /balance @username X ton|stars
# /balance 123456789 X ton|stars
